NODE_ENV=development
APP_PORT=3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=oficina
POSTGRES_PASSWORD=oficina123
POSTGRES_DB=oficina_mecanica
POSTGRES_SYNC=0

JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=1h

# Resend — https://resend.com
# API key (obrigatória; a API não sobe sem ela)
RESEND_API_KEY=re_sua_api_key

# Remetente: sandbox (só envia para o e-mail da conta Resend) ou domínio verificado
# Sandbox:  onboarding@resend.dev
# Produção: notificacoes@seu-dominio.com  (verifique DNS no painel Resend)
RESEND_FROM=onboarding@resend.dev

# Em dev/testes: redireciona TODOS os e-mails para esta caixa (omitir em produção)
RESEND_DEV_REDIRECT_TO=fiap-api-pos@outlook.com

# Destinatários fixos para alertas internos da oficina
NOTIFICACAO_EMAIL_MECANICOS=fiap-api-pos@outlook.com
NOTIFICACAO_EMAIL_ADMIN=fiap-api-pos@outlook.com