NODE_ENV=development
APP_PORT=3000

# Datadog Agent: fornecer a chave somente ao Agent. Nunca versionar a chave.
# Ideal: arquivo exclusivo do Agent, ignorado pelo Git (ver datadog/README.md).
# Ajustar ao site da conta Datadog (ex.: datadoghq.com ou datadoghq.eu).
DD_SITE=datadoghq.com
DD_ENV=dev
DD_SERVICE=oficina-mecanica-api
DD_VERSION=0.0.1
DD_TRACE_AGENT_URL=http://localhost:8126
DD_TRACE_ENABLED=true
DD_LOGS_INJECTION=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=oficina
POSTGRES_PASSWORD=oficina123
POSTGRES_DB=oficina_mecanica
POSTGRES_SYNC=0
POSTGRES_SSL=0
POSTGRES_SSL_REJECT_UNAUTHORIZED=0

JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=1h

# Resend — https://resend.com
# API key (obrigatória; a API não sobe sem ela)
RESEND_API_KEY=re_sua_api_key

# Remetente: sandbox (só envia para o e-mail da conta Resend) ou domínio verificado
# Sandbox:  onboarding@resend.dev
# Produção: notificacoes@fiap.tech  (verifique DNS no painel Resend)
RESEND_FROM=onboarding@resend.dev

# Em dev/testes: redireciona TODOS os e-mails para esta caixa (omitir em produção)
# Omitir (ou comentar) para enviar ao destinatário real.
RESEND_DEV_REDIRECT_TO=fiap-api-pos@outlook.com

# Destinatários fixos para alertas internos da oficina
NOTIFICACAO_EMAIL_MECANICOS=fiap-api-pos@outlook.com
NOTIFICACAO_EMAIL_ADMIN=fiap-api-pos@outlook.com
