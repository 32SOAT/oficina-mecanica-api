# Carregue com:
# cp .env.example .env
# source .env
#
# Este arquivo alimenta o Terraform via TF_VAR_* e tambem configura os scripts
# em infra/scripts. Troque os segredos antes de rodar terraform apply.

export AWS_REGION="us-east-1"
export AWS_DEFAULT_REGION="${AWS_REGION}"

export TF_VAR_aws_region="${AWS_REGION}"
export TF_VAR_project_name="oficina-mecanica"
export TF_VAR_environment="dev"
export TF_VAR_vpc_cidr="10.20.0.0/16"
export TF_VAR_az_count=2
export TF_VAR_single_nat_gateway=true
export TF_VAR_ecr_force_delete=true

# AWS Academy Learner Lab: nao cria IAM e usa gp2 no RDS.
export TF_VAR_use_existing_eks_iam_roles=true
export TF_VAR_eks_cluster_role_name="LabEksClusterRole"
export TF_VAR_eks_node_role_name="LabEksNodeRole"
export TF_VAR_db_storage_type="gp2"

# Restrinja estes CIDRs para seu IP/VPN em ambientes reais.
export TF_VAR_cluster_endpoint_public_access_cidrs='["0.0.0.0/0"]'
export TF_VAR_api_allowed_cidr_blocks='["0.0.0.0/0"]'

export TF_VAR_node_instance_types='["t3.micro"]'
export TF_VAR_node_capacity_type="ON_DEMAND"
export TF_VAR_node_desired_size=2
export TF_VAR_node_min_size=1
export TF_VAR_node_max_size=3
export TF_VAR_node_disk_size=30

export TF_VAR_db_name="oficina_mecanica"
export TF_VAR_db_username="oficina"
export TF_VAR_db_password="troque-esta-senha"
export TF_VAR_db_instance_class="db.t4g.micro"
export TF_VAR_db_allocated_storage=20
export TF_VAR_db_max_allocated_storage=100
export TF_VAR_db_backup_retention_period=0
export TF_VAR_db_multi_az=false
export TF_VAR_db_deletion_protection=false
export TF_VAR_db_skip_final_snapshot=true

export TF_VAR_api_name="fase2-kubernetes-oficina-mecanica-api"
export TF_VAR_kubernetes_namespace="oficina-mecanica"
export TF_VAR_api_replicas=1
export TF_VAR_api_container_port=3000
export TF_VAR_api_healthcheck_path="/api/v1/health"
export TF_VAR_api_image_pull_policy="Always"
export TF_VAR_api_hpa_min_replicas=1
export TF_VAR_api_hpa_max_replicas=3
export TF_VAR_api_hpa_target_cpu_utilization_percentage=70
export TF_VAR_api_wait_for_rollout=false

export API_IMAGE_PLATFORM="linux/amd64"
export API_IMAGE_TAG="latest"
export TF_VAR_api_image_tag="${API_IMAGE_TAG}"

export TF_VAR_node_env="production"
export TF_VAR_postgres_sync="0"
export TF_VAR_postgres_ssl="1"
export TF_VAR_postgres_ssl_reject_unauthorized="0"
export TF_VAR_jwt_secret="troque-este-jwt-secret-com-mais-de-16-caracteres"
export TF_VAR_jwt_expires_in="1h"

# Usado pelos scripts de publicacao/rollout.
export KUBECTL_ROLLOUT_TIMEOUT="5m"
export KUBECTL_DELETE_TIMEOUT="10m"
